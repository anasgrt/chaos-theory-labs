# Permanent management cluster. Labs use separate kind clusters.
node-name: chaos-labs
node-ip: {{ platform_ip }}
advertise-address: {{ platform_ip }}
tls-san:
  - {{ platform_ip }}
  - chaos-labs
write-kubeconfig-mode: "0600"
cni: canal
ingress-controller: traefik
resolv-conf: /run/systemd/resolve/resolv.conf
# Separate from kind's 10.244/16 Pods and 10.96/16 Services.
cluster-cidr: 10.42.0.0/16
service-cidr: 10.43.0.0/16
cluster-dns: 10.43.0.10
# RKE2 enables Secret encryption by default.
secrets-encryption-provider: aescbc
etcd-snapshot-retention: 5
